table Tareas_y_CUTs
	lineageTag: ce145458-0d6a-45d8-8915-0cc2f060de87

	measure Total_tareas = COUNTROWS(Tareas_y_CUTs)
		formatString: #,0
		lineageTag: 5eb21152-f35a-4fa2-bd9b-0c2bcba6692f

	measure Tareas_pendientes = CALCULATE(COUNTROWS(Tareas_y_CUTs), Tareas_y_CUTs[Estado] <> "Completado")
		formatString: #,0
		lineageTag: ab57b6fa-dde9-4800-8492-3b056485caeb

	measure Tareas_completadas = CALCULATE(COUNTROWS(Tareas_y_CUTs), Tareas_y_CUTs[Estado] = "Completado")
		formatString: #,0
		lineageTag: 9895860f-a522-4c69-9702-06c3efaa5884

	measure Avance = DIVIDE([Tareas_completadas], [Total_tareas], 0)
		formatString: 0.0%
		lineageTag: eb5e147c-4f3c-4da2-9ffe-234a7109bf4b

	measure Tareas_vencidas = COUNTROWS(FILTER(Tareas_y_CUTs, Tareas_y_CUTs[Estado] <> "Completado" && NOT ISBLANK(Tareas_y_CUTs[Fecha_Limite]) && IF(ISBLANK(Tareas_y_CUTs[Fecha_Hora_Limite]), Tareas_y_CUTs[Fecha_Limite] + TIME(17,0,0), Tareas_y_CUTs[Fecha_Hora_Limite]) < UTCNOW() - TIME(5,0,0)))
		formatString: #,0
		lineageTag: d1f94286-e8b9-4685-8187-5018cee76710

