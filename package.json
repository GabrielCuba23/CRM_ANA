{
  "name": "crm-whatsapp-ana",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-extension.mjs",
    "preview": "node scripts/local.mjs serve",
    "db:migrate": "node scripts/local.mjs migrate",
    "db:migrate:remote": "wrangler d1 migrations apply crm_ana_db --remote",
    "configure:d1": "node scripts/configure-d1.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:browser": "node tests/browser.mjs",
    "package": "python3 scripts/package.py",
    "deploy": "npm run build && wrangler pages deploy dist --project-name crm-whatsapp-ana"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  },
  "devDependencies": {
    "vite": "7.3.7",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "3.4.19",
    "postcss": "8.5.32",
    "autoprefixer": "10.4.22",
    "wrangler": "4.154.0",
    "playwright": "1.64.1"
  }
}
